# Machine-local inputs for ota/make-ota.sh (stock images pulled from the phone).
# See BUILD.md "Stock inputs" for how each of these was obtained.

# Raw dd images of the stock dynamic partitions (vendor, odm, vendor_dlkm,
# odm_dlkm, my_*.img), sha256-verified when extracted.
OP5911_STOCK_IMAGES=/mnt/kevin/kevin/Downloads/oneplus/ace/op5911_tree/extract/images

# Stock vendor_boot_b / boot_b (ColorOS PGZ110_15.0.0.1101). The recovery graft
# starts from this vendor_boot; boot is only used for the RAM-boot test image.
OP5911_STOCK_VENDOR_BOOT=/mnt/kevin/kevin/Downloads/oneplus/ace/stock_backup_b/vendor_boot_b.img
OP5911_STOCK_BOOT=/mnt/kevin/kevin/Downloads/oneplus/ace/stock_backup_b/boot_b.img

# Stock vbmeta (OPPO key, sha1 1a130f9a...) with flags=3. Must stay stock-signed:
# KeyMint binds the /data encryption key to the vbmeta root of trust.
OP5911_STOCK_VBMETA=/mnt/kevin/kevin/Downloads/oneplus/ace/stock_backup_b/vbmeta_b-stockkey-flags3.img

# Output directory for OTA zips and archived target-files (needs ~10 GB free;
# /tmp on this machine is too small for ota_from_target_files).
OP5911_OTA_OUT=/home/kevin/kevin/cs/android/aosp/out/op5911-ota
