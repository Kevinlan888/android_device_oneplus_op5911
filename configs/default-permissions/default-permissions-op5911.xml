<!-- AOSP DeskClock never gets POST_NOTIFICATIONS by default, so NotificationManager blocks
     its alarm notification and full-screen alarm (the alarm only plays sound). -->
<exceptions>
    <exception package="com.android.deskclock">
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
</exceptions>
