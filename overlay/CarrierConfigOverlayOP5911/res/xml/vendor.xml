     Device overrides merged on top of the AOSP per-carrier configs.
     Enables VoLTE through the MediaTek IMS service for the Chinese carriers.
-->
<carrier_config_list>
    <!-- Global fallback: this device's SIMs often stay carrierId=-1 (CarrierResolver
         has no match), so the carrier config is fetched before mcc/mnc are known and
         none of the filtered bundles below apply. An unfiltered bundle always matches
         (checkFilters passes when there are no attributes) and enables VoLTE via the
         MTK IMS stack regardless. Harmless where the network has no IMS: it just won't
         register. The per-carrier bundles below still win when they do match. -->
    <carrier_config>
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="editable_enhanced_4g_lte_bool" value="true" />
        <boolean name="hide_enhanced_4g_lte_bool" value="false" />
        <boolean name="carrier_vt_available_bool" value="false" />
        <boolean name="carrier_wfc_ims_available_bool" value="false" />
        <string name="config_ims_mmtel_package_override_string">com.mediatek.ims</string>
    </carrier_config>
