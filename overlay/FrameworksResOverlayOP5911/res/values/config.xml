    <!-- Dual SIM tray is hot-swappable -->
    <bool name="config_hotswapCapable">true</bool>
    <bool name="config_switch_phone_on_voice_reg_state_change">false</bool>

    <!-- Display: panel modes are 30/45/48/50/60/90/120 Hz. The stock vendor
         overlay caps the default peak at 90; ColorOS defaults to 120. -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer name="config_defaultRefreshRate">0</integer>

    <bool name="config_unplugTurnsOnScreen">true</bool>
    <bool name="config_enableBurnInProtection">true</bool>

    <!-- ===== Doze ===== -->

    <!-- DeviceIdle (light + deep doze). Off by default in AOSP. -->
    <bool name="config_enableAutoPowerModes">true</bool>

    <!-- Ambient display / AOD: the MTK display stack handles the panel's
         low-power mode (kernel: "[DISP]enter AOD"). Offered, but off until
         the user turns it on. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- "Lift to check phone": shows the Settings toggle. The sensor is the
         oplus pickup_detect sensor, bridged to a pulse by OplusDoze since
         SystemUI only knows TYPE_PICK_UP_GESTURE. -->
    <bool name="config_dozePulsePickup">true</bool>

    <!-- Pulse brightness (integer 1-255). A pulse puts the display in STATE_ON
         at this level; AOD itself (STATE_DOZE) uses the panel's own low-power
         brightness and ignores it. The default 5 was barely visible, 25 and 40
         too bright; 15 picked on device (2026-11-10). -->
    <integer name="config_screenBrightnessDoze">15</integer>
</resources>
