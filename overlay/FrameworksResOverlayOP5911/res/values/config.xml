<resources>
    <!-- Fingerprint: HIDL oplus fingerprint@2.1 HAL, sensor id 0,
         modality 2 (fingerprint), strength 15 (BIOMETRIC_STRONG) -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

    <!-- Lineage 22 only wakes the screen on a short power press when this is true -->
    <bool name="config_supportLongPressPowerWhenNonInteractive">true</bool>

    <!-- MediaTek IMS (com.mediatek.ims) -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_device_vt_available">false</bool>
    <bool name="config_device_wfc_ims_available">false</bool>
    <bool name="config_dynamic_bind_ims">true</bool>
    <string name="config_ims_package" translatable="false">com.mediatek.ims</string>
    <string name="config_ims_mmtel_package" translatable="false">com.mediatek.ims</string>

    <!-- ===== From LineageOS hardware/mediatek (Mssi*Overlay) and mt6895-common ===== -->

    <!-- 5G: MT6895 modem supports SA and NSA. Without these, Settings hides the
         5G preferred network types and SA/NSA reporting is disabled. -->
    <bool name="config_telephony5gStandalone">true</bool>
    <bool name="config_telephony5gNonStandalone">true</bool>

    <!-- MediaTek TCP buffer sizes per RAT -->
