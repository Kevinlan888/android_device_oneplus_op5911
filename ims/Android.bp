//
// MediaTek IMS service, TrebleDroid build:
//   https://treble.phh.me/ims-mtk-u.apk
// It uses sharedUserId android.uid.phone, so it must be re-signed with
// this build's platform key (certificate: "platform").

android_app_import {
    name: "MtkIms",
    apk: "MtkIms.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-com.mediatek.ims.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-com.mediatek.ims.xml",
    src: "privapp-permissions-com.mediatek.ims.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
